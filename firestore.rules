rules_version = '2';

// All Firestore access in this app goes through the Firebase Admin SDK on the
// server (see src/db). The Admin SDK bypasses these rules, so we deny ALL
// direct client access. Do not loosen this unless you intentionally start
// reading/writing Firestore from the browser.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
